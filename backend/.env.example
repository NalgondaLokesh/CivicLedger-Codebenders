# MongoDB Atlas connection string (placeholder values only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
# Preferred name; the legacy MONGODB_DB is still accepted
MONGODB_DB_NAME=civicledger

# Qdrant Cloud (optional; leave QDRANT_URL empty to disable)
QDRANT_URL=https://your-cluster.example.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=civicledger_schemes

# Groq API (optional; leave GROQ_API_KEY empty to disable)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

